# Copy to .env and fill in with your Supabase project values
# (Settings -> API in the Supabase dashboard). These two are safe to
# ship in the mobile app; EXPO_PUBLIC_ vars are bundled into the client.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
